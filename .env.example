# ─── DATABASE ─────────────────────────────────────────────────────────────
# MongoDB connection string — required for auth, orders, and admin features
MONGODB_URI=mongodb://localhost:27017/noolinnayambydivya

# ─── JWT SECRETS ──────────────────────────────────────────────────────────
# Used to sign and verify JSON Web Tokens for authentication
# Short-lived access token secret (15 mins)
JWT_SECRET=your-super-secret-jwt-key-change-this
# Long-lived refresh token secret (7 days)
JWT_REFRESH_SECRET=your-super-secret-jwt-refresh-key-change-this

# ─── ENVIRONMENT & SECURITY HYGIENE ──────────────────────────────────────
NODE_ENV=development
ALLOWED_ORIGIN=https://noolinnaayambydivya.com

# ─── OWNER ACCOUNT SEED ──────────────────────────────────────────────────
# Used by `npm run seed:owner` to create the admin/owner account
OWNER_EMAIL=owner@noolinnaayambydivya.com
OWNER_PASSWORD=change-this-strong-password

# ─── WHATSAPP COMMUNITY GROUP ─────────────────────────────────────────────
NEXT_PUBLIC_WHATSAPP_GROUP_URL=https://chat.whatsapp.com/GlV1BkokPC70K7XwVAlmYm?s=sw&p=i&mlu=0
