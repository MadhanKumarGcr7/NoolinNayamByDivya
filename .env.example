# ─── DATABASE ─────────────────────────────────────────────────────────────
# MySQL Connection URL for Prisma ORM
DATABASE_URL=mysql://root:password@localhost:3306/noolinnayam

# ─── JWT SECRETS ──────────────────────────────────────────────────────────
# Used to sign and verify JSON Web Tokens for authentication
# Short-lived access token secret (15 mins)
JWT_SECRET=your-super-secret-jwt-key-change-this
# Long-lived refresh token secret (7 days)
JWT_REFRESH_SECRET=your-super-secret-jwt-refresh-key-change-this

# ─── ENVIRONMENT & SECURITY HYGIENE ──────────────────────────────────────
NODE_ENV=development
ALLOWED_ORIGIN=https://noolinnaayambydivya.com

# ─── OWNER ACCOUNT SEED ──────────────────────────────────────────────────
# Used by `npm run seed:owner` to create the admin/owner account
OWNER_EMAIL=owner@noolinnaayambydivya.com
OWNER_PASSWORD=change-this-strong-password

# ─── WHATSAPP COMMUNITY GROUP ─────────────────────────────────────────────
NEXT_PUBLIC_WHATSAPP_GROUP_URL=https://chat.whatsapp.com/GlV1BkokPC70K7XwVAlmYm?s=sw&p=i&mlu=0

# ─── RAZORPAY PAYMENT GATEWAY ─────────────────────────────────────────────
# Key ID safe to expose to frontend for Checkout popup initialization
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
# Key Secret kept strictly server-side for Razorpay API calls & HMAC SHA-256 verification
RAZORPAY_KEY_SECRET=placeholder_razorpay_key_secret
# Webhook Secret kept strictly server-side for signature verification of incoming webhooks
RAZORPAY_WEBHOOK_SECRET=placeholder_razorpay_webhook_secret

